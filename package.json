{
  "name": "fisica",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @fisica/explicadora",
    "dev:explicadora": "npm run dev -w @fisica/explicadora",
    "dev:ingestor": "npm run dev -w @fisica/ingestor",
    "build": "npm run build -w @fisica/explicadora",
    "build:ingestor": "npm run build -w @fisica/ingestor",
    "test": "npm run test -w @fisica/physics-core && npm run test -w @fisica/ingestor",
    "export-catalog": "npm run export-catalog -w @fisica/ingestor",
    "lint": "npm run lint -w @fisica/explicadora"
  }
}
