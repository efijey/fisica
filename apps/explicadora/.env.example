# Copie para .env.local e preencha a chave.
# Usada para:
# - STT (Whisper): /api/mental/stt — transcreve o áudio gravado
# - Tutor LLM: /api/mental/turno — só em ajuda / correção parcial / correção final
#   (a fala do aluno vai direto para a folha, sem passar pela IA)
# - Treino personalizado: /api/personalizado/gerar — gera o exercício no mundo escolhido
# Sem esta variável, STT pode cair para Web Speech; correção usa fallback genérico;
# treino personalizado gera exercício mock.

OPENAI_API_KEY=

# Modelo que gera o treino personalizado (padrão: gpt-4o-mini).
# Testados: gpt-4.1 (bom e rápido), gpt-5.5 (mais rigoroso, ~10 s por exercício).
OPENAI_MODEL_PERSONALIZADO=
